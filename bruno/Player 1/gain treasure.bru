meta {
  name: Gain a treasure
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/gaintreasure
  body: json
  auth: inherit
}

body:json {
  {
    "issuer": {
      "id": "DrMint",
      "secret": "{{p1Secret}}"
    },
    "monsterId": "Monster 6"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
