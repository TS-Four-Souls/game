meta {
  name: Join the game
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/join
  body: json
  auth: inherit
}

body:json {
  {
    "id": "DrMint"
  }
}

script:post-response {
  if (res.body.secret) {
    bru.setVar('p1Secret', res.body.secret);
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
