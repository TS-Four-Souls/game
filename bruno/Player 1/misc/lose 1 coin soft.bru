meta {
  name: Lose 2 coin soft
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/losecoins
  body: json
  auth: inherit
}

body:json {
  {
    "issuer": {
      "id": "DrMint",
      "secret": "{{p1Secret}}"
    },
    "coins": 2,
    "asMany": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
