meta {
  name: Resolve stack
  type: http
  seq: 5
}

meta {
  name: Detailed state (JSON)
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/resolve
  body: json
  auth: inherit
}

headers {
